# Editor settings matching the existing code. Most editors read this file on their own; IntelliJ
# and VS Code (with the EditorConfig extension) both do. Line endings are also enforced by
# .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces as a line break.
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Generated by Gradle; left as it comes.
[{gradlew,gradlew.bat}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
